# =============================================================================
# Gomo6 — Caddy Reverse Proxy Configuration
# =============================================================================
# Set DOMAIN env var (e.g., example.com) for production with auto HTTPS.
# Without DOMAIN, defaults to localhost (HTTP only).
#
# Subdomains (automatically derived from $DOMAIN):
#   docs.{$DOMAIN}  → Documentation site
#   dev.{$DOMAIN}   → Dev Dashboard (OAuth app management)
#
# Local development with `.localhost` TLD works out of the box:
#   localhost       → Main site
#   docs.localhost  → Documentation
#   dev.localhost   → Dev Dashboard
# =============================================================================

{
	# email admin@example.com  # раскомментируй для получения писем от Let's Encrypt

	# ── HTTP/3 (QUIC) ──────────────────────────────────────────────────────
	# Caddy 2.6+ enables HTTP/3 by default; this pins it explicitly so it
	# survives config/version changes. QUIC runs over UDP 443 — the VPS
	# firewall AND the docker-compose port mapping must expose 443/udp or
	# clients silently fall back to TCP (HTTP/3 stays on but unused).
	# HTTP/3 is a big win on lossy/slow mobile networks: one connection,
	# no head-of-line blocking, faster handshake (0-RTT resumption).
	servers {
		protocols h1 h2 h3
	}
}

# Storage architecture:
# - Reads (GET/HEAD /storage/v1/object/*) → Caddy rewrites Host + path → Garage website port (direct)
# - Writes (POST /storage/v1/upload, DELETE /storage/v1/object/*) → Go backend → Garage S3 API
# path_regexp extracts bucket name and rewrites Host to <bucket>.storage.garage.localhost
# so Garage resolves the correct bucket in virtual-hosted style.

{$DOMAIN:localhost}, docs.{$DOMAIN:localhost}, dev.{$DOMAIN:localhost} {
	# ── Compression ───────────────────────────────────────────────────────
	# One compression layer at the edge for the whole site: static SPA files
	# (proxied from nginx), API JSON (Go backend), docs and dev dashboard.
	# zstd first (smaller + faster), gzip fallback for older clients. Only
	# text-like content types are encoded — images/videos pass through
	# untouched and WebSocket upgrades are never encoded. nginx gzip is
	# disabled in apps/web/nginx.conf to avoid double compression.
	encode zstd gzip

	# ── Security headers ──────────────────────────────────────────────────
	# HSTS is production-only; localhost must remain usable over HTTP.
	@production not host localhost docs.localhost dev.localhost
	header @production Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Generic strict policy for the main site and docs. It must EXCLUDE dev.*:
	# Caddy sorts header handlers by matcher specificity (matched routes run
	# before unconditional ones), so an unconditional block would run AFTER the
	# dev-specific override below and clobber its relaxed connect-src.
	@notdev not host dev.{$DOMAIN:localhost}
	header @notdev {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://challenges.cloudflare.com; script-src 'self' blob: https://integrate.depay.com https://challenges.cloudflare.com; worker-src 'self' blob: https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' wss: https://integrate.depay.com https://api.depay.com https://challenges.cloudflare.com https://*.ingest.sentry.io https://*.ingest.eu.sentry.io https://*.ingest.de.sentry.io; font-src 'self'; media-src 'self' blob:;"
	}

	# The Dev Dashboard (dev.*) runs its OAuth login as a client of the main
	# site: after the consent step its callback exchanges the code at
	# https://{$DOMAIN}/oauth/token and fetches /oauth/userinfo cross-origin.
	# Allow the main domain in connect-src for dev.* ONLY. This block fully
	# replaces the generic one for dev requests (Caddy would otherwise sort the
	# matched route here BEFORE the unconditional generic block, so the relaxed
	# CSP must not rely on file order — the generic block excludes dev.*).
	# NOTE: keep this policy in sync with the generic block — the only
	# difference is the added {$DOMAIN} connect-src.
	@devCsp host dev.{$DOMAIN:localhost}
	header @devCsp {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'self' https://challenges.cloudflare.com; script-src 'self' blob: https://integrate.depay.com https://challenges.cloudflare.com; worker-src 'self' blob: https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' wss: http://{$DOMAIN:localhost} https://{$DOMAIN:localhost} https://integrate.depay.com https://api.depay.com https://challenges.cloudflare.com https://*.ingest.sentry.io https://*.ingest.eu.sentry.io https://*.ingest.de.sentry.io; font-src 'self'; media-src 'self' blob:;"
	}

	# ── Logging ────────────────────────────────────────────────────────────
	log {
		output stdout
		format json
	}

	# ── Documentation (docs.* subdomain) ──────────────────────────────────
	@docs host docs.{$DOMAIN:localhost}
	handle @docs {
		handle /api/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /oauth/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /.well-known/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle {
			reverse_proxy docs:80
		}
	}

	# ── Dev Dashboard (dev.* subdomain) ───────────────────────────────────
	@dev host dev.{$DOMAIN:localhost}
	handle @dev {
		handle /api/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /oauth/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		# Messenger uploads and profile-wall media are private and always go
		# through the authenticated Go proxy, which enforces chat membership and
		# wall visibility (canViewUserWall). Keep this handler before the generic
		# public bucket proxy.
		@privateStorageGet {
			method GET HEAD
			path_regexp private_storage_read ^/storage/v1/object/(uploads|wall)/(.+)$
		}
		handle @privateStorageGet {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}

		@storageGet {
			method GET HEAD
			not path /storage/v1/object/uploads/*
			not path /storage/v1/object/wall/*
			path_regexp storage_read ^/storage/v1/object/([^/]+)/(.+)$
		}
		handle @storageGet {
			route {
				header {
					Access-Control-Allow-Origin "*"
					Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
					Access-Control-Allow-Headers "Content-Type, Range"
					Access-Control-Expose-Headers "Content-Length, Content-Range, Content-Type, Accept-Ranges"
					Cache-Control "public, max-age=3600"
					Accept-Ranges "bytes"
					# Untrusted media is served directly from Garage for public
					# buckets. Sandbox the document so a legacy object stored with
					# a forged HTML-capable Content-Type can never execute scripts
					# in the app origin (H2.1 defense-in-depth for pre-fix files).
					Content-Security-Policy "sandbox"
				}
				rewrite * /{re.storage_read.2}
				reverse_proxy garage:3902 {
					header_up Host "{re.storage_read.1}.storage.garage.localhost"
				}
			}
		}
		handle /storage/v1/upload {
			reverse_proxy backend:8080
		}
		@storageDelete {
			path /storage/v1/object/*
			method DELETE
		}
		handle @storageDelete {
			reverse_proxy backend:8080
		}
		handle {
			reverse_proxy dev-dashboard:80
		}
	}

	# ── Main Web App (localhost or custom domain) ─────────────────────────
	@main host {$DOMAIN:localhost}
	handle @main {
		handle /api/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		# /oauth/consent is a frontend SPA route, not a backend API
		handle /oauth/consent* {
			reverse_proxy web:80
		}
		handle /oauth/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /rest/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /rpc/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /.well-known/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /federation/* {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		handle /ws {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}
		# ── Storage: reads → Garage (direct), writes → backend ────────────────
		# path_regexp captures bucket (group 1) and key (group 2) from the URL.
		# Host header is rewritten to <bucket>.storage.garage.localhost so Garage
		# resolves the correct bucket in virtual-hosted style.
		# Messenger uploads and profile-wall media are private: send them to Go,
		# which checks chat_members and wall visibility (canViewUserWall) before
		# reading from Garage. This must precede the generic public Garage
		# website proxy below.
		@privateStorageGet {
			method GET HEAD
			path_regexp private_storage_read ^/storage/v1/object/(uploads|wall)/(.+)$
		}
		handle @privateStorageGet {
			reverse_proxy backend:8080 {
				transport http {
					dial_timeout 5s
					write_timeout 30s
				}
			}
		}

		@storageGet {
			method GET HEAD
			not path /storage/v1/object/uploads/*
			not path /storage/v1/object/wall/*
			path_regexp storage_read ^/storage/v1/object/([^/]+)/(.+)$
		}
		handle @storageGet {
			route {
				header {
					Access-Control-Allow-Origin "*"
					Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
					Access-Control-Allow-Headers "Content-Type, Range"
					Access-Control-Expose-Headers "Content-Length, Content-Range, Content-Type, Accept-Ranges"
					Cache-Control "public, max-age=3600"
					Accept-Ranges "bytes"
					# Untrusted media is served directly from Garage for public
					# buckets. Sandbox the document so a legacy object stored with
					# a forged HTML-capable Content-Type can never execute scripts
					# in the app origin (H2.1 defense-in-depth for pre-fix files).
					Content-Security-Policy "sandbox"
				}
				rewrite * /{re.storage_read.2}
				reverse_proxy garage:3902 {
					header_up Host "{re.storage_read.1}.storage.garage.localhost"
				}
			}
		}
		handle /storage/v1/upload {
			reverse_proxy backend:8080
		}
		@storageDelete {
			path /storage/v1/object/*
			method DELETE
		}
		handle @storageDelete {
			reverse_proxy backend:8080
		}
		handle /health {
			reverse_proxy backend:8080
		}

		# ── Social previews (Open Graph) ──────────────────────────────────
		# The web app is a JS SPA, so deep links (wall posts, threads,
		# profiles, boards) can't provide OG meta tags client-side. Link
		# preview crawlers (Telegram, WhatsApp, X/Twitter, Reddit, Discord,
		# Slack, VK, LinkedIn, Facebook, iMessage…) don't execute JS — they
		# only read the server response. Route them to the Go backend, which
		# renders a full HTML page with per-content OG/Twitter meta tags.
		# SEO crawlers (Googlebot, Bingbot, YandexBot…) are intentionally NOT
		# matched: they render JS and should keep indexing the real SPA.
		#
		# Public OG image proxy for private wall attachments (/og/wall/<key>)
		# must come first — it is matched by both matchers otherwise.
		handle /og/* {
			reverse_proxy backend:8080
		}
		@bot {
			# NOTE: `header User-Agent ~regex` is NOT a regex matcher in Caddy v2
			# (the ~-prefixed form only existed in Caddy v1) — Caddy treats the
			# value as a literal exact match, so crawlers were silently served the
			# SPA. header_regexp is the supported regex form (RE2, case-insensitive
			# via the (?i) inline flag, substring match by default).
			header_regexp User-Agent (?i)(TelegramBot|Twitterbot|facebookexternalhit|Facebot|Discordbot|Slackbot|Slack-ImgProxy|VKShare|vk[.]com|LinkedInBot|WhatsApp|Viber|Pinterest|redditbot|SkypeUriPreview|Snapchat|Applebot|Instagram|embed[.]ly|microsoftteams|Linbot|YoozBot|MJ12bot|DotBot|DuckDuckBot|Bytespider|PetalBot)
			not path /api/*
			not path /rest/*
			not path /rpc/*
			not path /storage/*
			not path /oauth/*
			not path /federation/*
			not path /.well-known/*
			not path /docs/*
			not path /og/*
			not path /ws*
			not path /health
			not path /ready
			not path /metrics
			# Static assets served by nginx — crawlers fetch og:image and
			# favicon/etc. with their bot UA; these must keep going to the web
			# container, not to the OG renderer.
			not path /photoes/*
			not path /assets/*
			not path /favicon*
			not path /apple-touch-icon*
			not path /pwa-*
			not path /placeholder.svg
			not path /default-audio-cover.jpg
			not path /robots.txt
			not path /sitemap.xml
		}
		handle @bot {
			reverse_proxy backend:8080
		}
		handle {
			reverse_proxy web:80
		}
	}

	# ── Fallback ─────────────────────────────────────────────────────────
	handle {
		respond "Not Found" 404
	}
}


