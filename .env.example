# =============================================================================
# Gomo6 — Configuration Template
# =============================================================================
# Скопируйте в .env и заполните своими значениями.
# Либо используйте deploy.sh для автоматической генерации.
# =============================================================================

# ── Domain ──────────────────────────────────────────────────────────────────
# Для продакшна: ваш домен (e.g. example.com)
# Для разработки: localhost
DOMAIN=localhost

# ── Security ────────────────────────────────────────────────────────────────
# Сгенерируйте случайные 64-символьные hex-ключи:
#   openssl rand -hex 32
JWT_SECRET=
FEDERATION_KEY=

# ── Messenger Encryption ────────────────────────────────────────────────────
# Ключ шифрования сообщений (AES-256, ровно 32 байта).
# Генерация: openssl rand -hex 32
# Обязательно — без него бэкенд не запустится.
MESSENGER_ENCRYPTION_KEY=

# ── Redis ───────────────────────────────────────────────────────────────────
# Пароль Redis. Генерация: openssl rand -hex 16
# Обязательно — без него Redis не запустится.
REDIS_PASSWORD=

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Allowed CORS origins ────────────────────────────────────────────────────
# Для продакшна: https://example.com,http://example.com,https://docs.example.com,...
ALLOWED_ORIGINS=http://localhost,http://docs.localhost,http://dev.localhost

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Обязательно для production Compose. Генератор добавит безопасное значение,
# если переменная отсутствует или пуста, сохранив существующий пароль.
POSTGRES_PASSWORD=

# ── S3 / Garage ─────────────────────────────────────────────────────────────
# Внутренние Garage credentials никогда не коммитьте. Генератор добавит их
# в .env, а перед Compose создаст .garage.toml (mode 600).
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# S3 key создаётся один раз в Garage и хранится только в volume garage_keys.
# GARAGE_S3_ACCESS_KEY=GK...
# GARAGE_S3_SECRET_KEY=...
#
# Браузер не обращается к Garage напрямую — все загрузки идут через backend.
# GARAGE_S3_PUBLIC_ENDPOINT больше не нужен.
