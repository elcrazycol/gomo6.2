                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "sum by (route) (rate(http_server_errors_total[5m])) * 60"
                    }
                  }
                }
              }
            ]
          }
        },
        "11_11": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "HTTP: 429 (рейт-лимит)/мин по роутам"
