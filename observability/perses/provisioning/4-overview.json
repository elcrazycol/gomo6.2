[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "Overview",
      "project": "gomo6"
    },
    "spec": {
      "display": {
        "name": "gomo6 · Обзор"
      },
      "duration": "3h",
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Backend: доступность",
              "description": "1 = vmagent успешно скрейпит /metrics"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "up{job=\"backend\"}"
                    }
                  }
                }
              }
            ]
          }
        },
        "0_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "HTTP: доля 5xx, %",
              "description": "Выше 5% на 10 минут — сработает HighServerErrorRate"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * sum(rate(http_server_errors_total[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "HTTP: запросов/мин по роутам"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
