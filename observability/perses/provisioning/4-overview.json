[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "overview",
      "project": "gomo6"
    },
    "spec": {
      "display": {
        "name": "gomo6 · Обзор (RED)"
      },
      "duration": "3h",
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Запросы/с",
              "description": "Суммарный RPS по всем эндпоинтам"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "value",
                "sparkline": {
                  "color": "#3584e4",
                  "width": 1
                },
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 2
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "sum(rate(http_requests_total[5m]))"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Ошибки 5xx, %",
              "description": "Порог алерта — 5% за 10 минут"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "background_solid",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                },
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 2
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 1,
                      "color": "#f5c211"
                    },
                    {
                      "value": 5,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * sum(rate(http_server_errors_total[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)"
                    }
                  }
                }
              }
            ]
          }
        },
        "2_2": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "p99 латентность",
              "description": "99-й перцентиль; алерт срабатывает выше 1 с"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "background_solid",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                },
                "format": {
                  "unit": "milliseconds",
                  "decimalPlaces": 0
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 200,
                      "color": "#f5c211"
                    },
                    {
                      "value": 1000,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "1000 * histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"
                    }
                  }
                }
              }
            ],
            "links": [
              {
                "name": "Открыть p99 в vmui",
                "url": "http://localhost:9428/vmui/#/?g0.expr=1000%20%2A%20histogram_quantile%280.99%2C%20sum%20by%20%28le%29%20%28rate%28http_request_duration_seconds_bucket%5B5m%5D%29%29%29&g0.range_input=1h"
              }
            ]
          }
        },
        "3_3": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "WebSocket",
              "description": "Активные realtime-соединения"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "value",
                "sparkline": {
                  "color": "#9141ac",
                  "width": 1
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "messenger_ws_active_connections"
                    }
                  }
                }
              }
            ]
          }
        },
        "4_4": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Трафик по классам, rps",
              "description": "Из чего состоит нагрузка: успешные, клиентские ошибки, серверные, рейт-лимит"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "max"
                  ]
                },
                "visual": {
                  "display": "line",
                  "stack": "all"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(clamp_min(sum(rate(http_requests_total[5m])) - sum(rate(http_client_errors_total[5m])) - sum(rate(http_server_errors_total[5m])) - sum(rate(http_rate_limited_total[5m])), 0), \"class\", \"2xx\", \"\", \"\")"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(sum(rate(http_client_errors_total[5m])), \"class\", \"4xx\", \"\", \"\")"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(sum(rate(http_server_errors_total[5m])), \"class\", \"5xx\", \"\", \"\")"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(sum(rate(http_rate_limited_total[5m])), \"class\", \"429\", \"\", \"\")"
                    }
                  }
                }
              }
            ],
            "links": [
              {
                "name": "Все запросы в vmui",
                "url": "http://localhost:9428/vmui/#/?g0.expr=sum%20by%20%28route%29%20%28rate%28http_requests_total%5B5m%5D%29%29&g0.range_input=3h"
              }
            ]
          }
        },
        "5_5": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Доля ошибок 5xx, %",
              "description": "Держим ниже 5%: выше — алерт и сообщение в Telegram"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "list"
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 1,
                      "color": "#f5c211"
                    },
                    {
                      "value": 5,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(100 * sum(rate(http_server_errors_total[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001), \"series\", \"5xx %\", \"\", \"\")"
                    }
                  }
                }
              }
            ],
            "links": [
              {
                "name": "5xx по роутам в vmui",
                "url": "http://localhost:9428/vmui/#/?g0.expr=sum%20by%20%28route%29%20%28rate%28http_server_errors_total%5B5m%5D%29%29&g0.range_input=3h"
              }
            ]
          }
        },
        "6_6": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Латентность: p50 / p90 / p99, мс",
              "description": "p50 — типичный запрос, p99 — хвост: именно там живёт «сайт иногда виснет»"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "mean",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(1000 * histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m]))), \"series\", \"p50\", \"\", \"\")"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(1000 * histogram_quantile(0.9, sum by (le) (rate(http_request_duration_seconds_bucket[5m]))), \"series\", \"p90\", \"\", \"\")"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(1000 * histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m]))), \"series\", \"p99\", \"\", \"\")"
                    }
                  }
                }
              }
            ],
            "links": [
              {
                "name": "p95 по роутам в vmui",
                "url": "http://localhost:9428/vmui/#/?g0.expr=1000%20%2A%20histogram_quantile%280.95%2C%20sum%20by%20%28le%2C%20route%29%20%28rate%28http_request_duration_seconds_bucket%5B5m%5D%29%29%29&g0.range_input=3h"
              }
            ]
          }
        },
        "7_7": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "p95 сейчас и неделю назад, мс",
              "description": "Сравнение с историей через `offset 1w`: стало хуже или так всегда было?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "mean"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m]))), \"series\", \"сейчас\", \"\", \"\")"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "label_replace(1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m] offset 1w))), \"series\", \"неделю назад\", \"\", \"\")"
                    }
                  }
                }
              }
            ],
            "links": [
              {
                "name": "p95 неделю назад в vmui",
                "url": "http://localhost:9428/vmui/#/?g0.expr=1000%20%2A%20histogram_quantile%280.95%2C%20sum%20by%20%28le%29%20%28rate%28http_request_duration_seconds_bucket%5B5m%5D%20offset%201w%29%29%29&g0.range_input=3h"
              }
            ]
          }
        },
        "8_8": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Топ роутов: rps, ошибки, 429, p95",
              "description": "Сортировка по объёму — куда смотреть в первую очередь"
            },
            "plugin": {
              "kind": "TimeSeriesTable",
              "spec": {}
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "sum by (route) (rate(http_requests_total[5m]))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "sum by (route) (rate(http_server_errors_total[5m]))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "sum by (route) (rate(http_rate_limited_total[5m]))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "1000 * histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))"
                    }
                  }
                }
              }
            ]
          }
        },
        "9_9": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "HTTP: запросов/мин по роутам"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "right",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
