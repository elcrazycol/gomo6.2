                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "sum by (route) (rate(http_requests_total[5m])) * 60"
                    }
                  }
                }
              }
            ]
          }
        },
        "10_10": {
          "kind": "Panel",
          "spec": {
