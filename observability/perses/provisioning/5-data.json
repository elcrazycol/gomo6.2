                "content": {
                  "$ref": "#/spec/panels/3_0"
                }
              },
              {
                "x": 12,
                "y": 15,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/3_1"
                }
              },
              {
                "x": 0,
                "y": 20,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/4_0"
                }
              },
              {
                "x": 12,
                "y": 20,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/4_1"
                }
              }
            ]
          }
        }
      ]
    }
  }
