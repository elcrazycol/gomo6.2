[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "Data",
      "project": "gomo6"
    },
    "spec": {
      "display": {
        "name": "gomo6 · Данные (Postgres / Redis)"
      },
      "duration": "3h",
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Postgres: соединения / максимум",
              "description": "Алерт срабатывает выше 80%"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "pg_stat_database_numbackends{datname=\"gomo6\"}"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "pg_settings_max_connections"
                    }
                  }
                }
              }
            ]
          }
        },
        "0_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Postgres: попадания в кэш, %",
              "description": "Ниже 90% — запросы уходят на диск"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * sum(rate(pg_stat_database_blks_hit{datname=\"gomo6\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"gomo6\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"gomo6\"}[5m])), 0.001)"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Postgres: транзакций/мин"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(pg_stat_database_xact_commit{datname=\"gomo6\"}[5m]) * 60"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(pg_stat_database_xact_rollback{datname=\"gomo6\"}[5m]) * 60"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Postgres: дедлоки (за 15 мин)",
              "description": "Должно быть 0"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "increase(pg_stat_database_deadlocks{datname=\"gomo6\"}[15m])"
                    }
                  }
                }
              }
            ]
          }
        },
        "2_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Postgres: размер базы, МБ"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "pg_database_size_bytes{datname=\"gomo6\"} / 1048576"
                    }
                  }
                }
              }
            ]
          }
        },
        "2_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Postgres: время чтения/записи блоков, с/с"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(pg_stat_database_blk_read_time{datname=\"gomo6\"}[5m])"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(pg_stat_database_blk_write_time{datname=\"gomo6\"}[5m])"
                    }
                  }
                }
              }
            ]
          }
        },
        "3_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Redis: hit ratio, %",
              "description": "Кэш: доля попаданий. Низко — TTL/набор ключей не работают"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * sum(rate(redis_keyspace_hits_total[15m])) / clamp_min(sum(rate(redis_keyspace_hits_total[15m])) + sum(rate(redis_keyspace_misses_total[15m])), 0.001)"
                    }
                  }
                }
              }
            ]
          }
        },
        "3_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Redis: память, МБ"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "redis_memory_used_bytes / 1048576"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "redis_memory_used_dataset_bytes / 1048576"
                    }
                  }
                }
              }
            ]
          }
        },
        "4_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Redis: клиенты и ключи"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "redis_connected_clients"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "redis_db_keys"
                    }
                  }
                }
              }
            ]
          }
        },
        "4_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Redis: операций/с и вытеснения (15 мин)",
              "description": "Вытеснения > 0 — мало памяти"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "values": [
                    "mean",
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(redis_commands_processed_total[5m])"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "increase(redis_evicted_keys_total[15m])"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "Data"
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/0_0"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/0_1"
                }
              },
              {
                "x": 0,
                "y": 5,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/1_0"
                }
              },
              {
                "x": 12,
                "y": 5,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/1_1"
                }
              },
              {
                "x": 0,
                "y": 10,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/2_0"
                }
              },
              {
                "x": 12,
                "y": 10,
                "width": 12,
                "height": 5,
                "content": {
                  "$ref": "#/spec/panels/2_1"
                }
              },
              {
                "x": 0,
                "y": 15,
                "width": 12,
