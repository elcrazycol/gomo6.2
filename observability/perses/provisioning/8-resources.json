[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "resources",
      "project": "gomo6"
    },
    "spec": {
      "display": {
        "name": "gomo6 · Ресурсы (USE)"
      },
      "duration": "3h",
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "CPU, %",
              "description": "Утилизация единственного ядра"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "background_solid",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                },
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 70,
                      "color": "#f5c211"
                    },
                    {
                      "value": 90,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "RAM, %",
              "description": "Память хоста: 961 МБ всего"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "background_solid",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                },
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 80,
                      "color": "#f5c211"
                    },
                    {
                      "value": 92,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
                    }
                  }
                }
              }
            ]
          }
        },
        "2_2": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Диск /, %",
              "description": "Занято на корневом разделе"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "background_solid",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                },
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 80,
                      "color": "#f5c211"
                    },
                    {
                      "value": 90,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})"
                    }
                  }
                }
              }
            ]
          }
        },
        "3_3": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Swap, %",
              "description": "Использование свопа — признак нехватки RAM"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "background_solid",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                },
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "mode": "absolute",
                  "defaultColor": "#33d17a",
                  "steps": [
                    {
                      "value": 10,
                      "color": "#f5c211"
                    },
                    {
                      "value": 50,
                      "color": "#e01b24"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * (node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / clamp_min(node_memory_SwapTotal_bytes, 1)"
                    }
                  }
                }
              }
            ]
          }
        },
        "4_4": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Утилизация: CPU / RAM / Диск, %",
              "description": "USE · Utilization — сколько ресурса занято"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})"
                    }
                  }
                }
              }
            ]
          }
        },
        "5_5": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Сатурация: load и пул БД",
              "description": "USE · Saturation — очередь на ресурс (load5 и % занятых соединений БД)"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "node_load5"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "100 * db_in_use_connections / clamp_min(db_max_open_connections, 1)"
                    }
                  }
                }
              }
            ]
          }
        },
        "6_6": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Память по контейнерам, МБ",
              "description": "Кто ест память — из textfile-коллектора (без cAdvisor)"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "right",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "topk(6, container_memory_usage_bytes) / 1048576"
                    }
                  }
                }
              }
            ]
          }
        },
        "7_7": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "USE · Errors: OOM-киллы и дропы сети",
              "description": "Молчаливые сбои: убитые процессы и потерянные пакеты"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "increase(node_vmstat_oom_kill[1h])"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(node_network_receive_drop_total{device!~\"lo|veth.*|br-.*\"}[5m])"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(node_network_transmit_drop_total{device!~\"lo|veth.*|br-.*\"}[5m])"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "resources"
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/0_0"
                }
              },
              {
                "x": 6,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/1_1"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/2_2"
                }
              },
              {
                "x": 18,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/3_3"
                }
              },
              {
                "x": 0,
                "y": 6,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/4_4"
                }
              },
              {
                "x": 12,
                "y": 6,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/5_5"
                }
              },
              {
                "x": 0,
                "y": 14,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/6_6"
                }
              },
              {
                "x": 12,
                "y": 14,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/7_7"
                }
              }
            ]
          }
        }
      ],
      "links": [
        {
          "name": "vmui",
          "url": "http://localhost:9428/vmui"
        },
        {
          "name": "Хост (детально)",
          "url": "http://localhost:9080/projects/gomo6/dashboards/host"
        }
      ]
    }
  }
]