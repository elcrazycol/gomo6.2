[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "product",
      "project": "gomo6"
    },
    "spec": {
      "display": {
        "name": "gomo6 · Продукт"
      },
      "duration": "24h",
      "panels": {
        "0_0": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Регистрации, всего",
              "description": "Всего аккаунтов за всё время"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "value",
                "sparkline": {
                  "color": "#33d17a",
                  "width": 1
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "app_registrations_total"
                    }
                  }
                }
              }
            ]
          }
        },
        "1_1": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Сообщений в чате",
              "description": "Всего сообщений мессенджера"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "value",
                "sparkline": {
                  "color": "#3584e4",
                  "width": 1
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "app_chat_messages_total"
                    }
                  }
                }
              }
            ]
          }
        },
        "2_2": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Онлайн сейчас",
              "description": "Подключены по WebSocket прямо сейчас"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "value",
                "sparkline": {
                  "color": "#9141ac",
                  "width": 1
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "app_users_online"
                    }
                  }
                }
              }
            ]
          }
        },
        "3_3": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Активны сегодня",
              "description": "Заходили сегодня (user_daily_visits, кэш 5 мин)"
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last-number",
                "colorMode": "value",
                "sparkline": {
                  "color": "#ff7800",
                  "width": 1
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "app_users_active_today"
                    }
                  }
                }
              }
            ]
          }
        },
        "4_4": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "События в минуту",
              "description": "Регистрации, треды, посты, записи на стене, сообщения"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table",
                  "values": [
                    "last-number",
                    "max"
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(app_registrations_total[15m]) * 60"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(app_threads_created_total[15m]) * 60"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(app_posts_created_total[15m]) * 60"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(app_wall_posts_created_total[15m]) * 60"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(app_chat_messages_total[15m]) * 60"
                    }
                  }
                }
              }
            ]
          }
        },
        "5_5": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "WebSocket: рассылки в минуту и средняя длительность, с",
              "description": "Реальный realtime-трафик: всплески = наплыв активности"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "list"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "rate(messenger_ws_broadcasts_total[5m]) * 60"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "messenger_ws_broadcast_duration_seconds"
                    }
                  }
                }
              }
            ]
          }
        },
        "6_6": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Создание контента, всего (прирост)",
              "description": "Насколько сообщество живо за последний час"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom",
                  "mode": "table"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "increase(app_threads_created_total[1h])"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "increase(app_posts_created_total[1h])"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "datasource": {
                        "kind": "PrometheusDatasource",
                        "name": "victoriametrics"
                      },
                      "query": "increase(app_wall_posts_created_total[1h])"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "product"
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/0_0"
                }
              },
              {
                "x": 6,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/1_1"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/2_2"
                }
              },
              {
                "x": 18,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/3_3"
                }
              },
              {
                "x": 0,
                "y": 6,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/4_4"
                }
              },
              {
                "x": 12,
                "y": 6,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/5_5"
                }
              },
              {
                "x": 0,
                "y": 14,
                "width": 12,
                "height": 8,
                "content": {
                  "$ref": "#/spec/panels/6_6"
                }
              }
            ]
          }
        }
      ],
      "links": [
        {
          "name": "vmui",
          "url": "http://localhost:9428/vmui"
        },
        {
          "name": "Обзор",
          "url": "http://localhost:9080/projects/gomo6/dashboards/overview"
        }
      ]
    }
  }
]